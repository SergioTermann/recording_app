<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Glimpse</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>Glimpse</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.6.2</string>
	<key>CFBundleVersion</key>
	<string>16</string>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Glimpse需要使用麦克风来录制并保存你的声音。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Glimpse使用系统语音识别把录音转换为文字，并自动保存 TXT 文件。</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.zinger.quickrecord.daily-summary</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>QuickRecord</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>quickrecord</string>
			</array>
		</dict>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Glimpse 在同一 Wi-Fi 下连接已配对的 Mac，加密传输录音与文字进行归档。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_glimpse-sync._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>扫描 Mac 上的配对二维码，安全连接你的归档电脑。</string>
</dict>
</plist>
